            "name": "identifier",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "active",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "partof",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hsa-id",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Sökning på HSA-id-identifieraren (system \u003d urn:oid:1.2.752.29.4.19)."
          },
          {
            "name": "hsa-org-class",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Sökning på HSA-objektklassificering. Filtrerar på type.coding med system \u003d \u0027https://hsa.inera.se/fhir/CodeSystem/hsa-object-class\u0027."
          }
        ]
      },
