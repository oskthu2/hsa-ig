         fhir:link <https://hsa.inera.se/fhir/CapabilityStatement/hsa-client-npo> ;
         fhir:reference [ fhir:v "CapabilityStatement/hsa-client-npo" ]
       ] ;
       fhir:name [ fhir:v "HSA Klient – Nationell Patientöversikt (NPÖ)" ] ;
       fhir:description [ fhir:v "Illustrerar vilka FHIR-förmågor ett NPÖ-liknande scenario kan ha nytta av.\nExemplet visar hur en vårdenhet kan slås upp via arbetsplatskod (APK) och hur\npartOf-kedjan kan traverseras uppåt för att fastställa ansvarig vårdgivare." ] ;
