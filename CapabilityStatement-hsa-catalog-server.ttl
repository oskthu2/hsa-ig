@prefix fhir: <http://hl7.org/fhir/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# - resource -------------------------------------------------------------------

<https://hsa.inera.se/fhir/CapabilityStatement/hsa-catalog-server> a fhir:CapabilityStatement ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "hsa-catalog-server"] ; # 
  fhir:text [
     fhir:status [ fhir:v "extensions" ] ;
     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Genererad berättande text: CapabilityStatement hsa-catalog-server</b></p><a name=\"hsa-catalog-server\"> </a><a name=\"hchsa-catalog-server\"> </a><h2 id=\"title\">HSA Central Catalog Server</h2><ul><li>Implementationsguidens version: 0.1.0 </li><li>FHIR-version: 5.0.0 </li><li>Format som stöds: <code>json</code>, <code>xml</code></li><li>Publicerad: 2026-05-21 </li><li>Publicerad av: Inera AB / HSA-IG projekt </li></ul><blockquote class=\"impl-note\"><p><strong>Notera till implementörer: FHIR-förmågor</strong></p><p>Vilken FHIR-förmåga som helst kan vara 'tillåten' av systemet om den inte uttryckligen är markerad som 'SHALL NOT'. Några objekt är markerade som MAY i implementationsguiden för att belysa deras potentiella relevans för användningsfallet.</p></blockquote><h2 id=\"rest\">FHIR RESTful-förmågor</h2><div class=\"panel panel-default\"><div class=\"panel-heading\"><h3 id=\"mode1\" class=\"panel-title\">Mode: <code>server</code></h3></div><div class=\"panel-body\"><div><p>Läs- och sök-API för HSA-katalogen.\nPublik synlighet filtreras via _security-parametern (destination indicator 03).\nSkrivoperationer stöds inte på detta gränssnitt.</p>\n</div></div></div><h3 id=\"resourcesCap1\">Förmågor per resurs/profil</h3><h4 id=\"resourcesSummary1\">Sammanfattning</h4><p>Sammanfattningstabellen listar resurserna som ingår i denna konfiguration, och för varje resurs listar den:</p><ul><li>De relevanta profilerna (om några)</li><li>Interaktionerna som stöds av varje resurs (<b><span class=\"bg-info\">R</span></b>ead, <b><span class=\"bg-info\">S</span></b>earch, <b><span class=\"bg-info\">U</span></b>pdate, and <b><span class=\"bg-info\">C</span></b>reate, are always shown, while <b><span class=\"bg-info\">VR</span></b>ead, <b><span class=\"bg-info\">P</span></b>atch, <b><span class=\"bg-info\">D</span></b>elete, <b><span class=\"bg-info\">H</span></b>istory on <b><span class=\"bg-info\">I</span></b>nstance, or <b><span class=\"bg-info\">H</span></b>istory on <b><span class=\"bg-info\">T</span></b>yp är endast närvarande om minst en av resurserna har stöd för dem.</li><li><span>De obligatoriska, rekommenderade och vissa valfria sökparametrarna (om några). </span></li><li>De länkade resurserna aktiverade för <code>_include</code></li><li>De övriga resurserna aktiverade för <code>_revinclude</code></li><li>Operationerna på resursen (om några)</li></ul><div class=\"table-responsive\"><table class=\"table table-condensed table-hover\"><thead><tr><th><b>Resurstyp</b></th><th><b>Profil</b></th><th class=\"text-center\"><b title=\"GET en resurs (läs-interaktion)\">R</b></th><th class=\"text-center\"><b title=\"GET alla resurser av typen (sök-interaktion)\">S</b></th><th class=\"text-center\"><b title=\"PUT en ny resursversion (uppdatera-interaktion)\">U</b></th><th class=\"text-center\"><b title=\"POST en ny resurs (skapa-interaktion)\">C</b></th><th><b title=\"Obligatoriska och rekommenderade sökparametrar\">Sökningar</b></th><th><code><b>_include</b></code></th><th><code><b>_revinclude</b></code></th><th><b>Operationer</b></th></tr></thead><tbody><tr><td><a href=\"#Organization1-1\">Organization</a></td><td><a href=\"StructureDefinition-hsa-catalog-organization.html\">https://hsa.inera.se/fhir/StructureDefinition/hsa-catalog-organization</a><br/><em>Ytterligare stödda profiler:</em><br/>  <a href=\"StructureDefinition-hsa-healthcare-provider-organization.html\">HSA Healthcare Provider Organization</a><br/>  <a href=\"StructureDefinition-hsa-healthcare-unit-organization.html\">HSA Healthcare Unit Organization</a></td><td class=\"text-center\">y</td><td class=\"text-center\">y</td><td class=\"text-center\"/><td class=\"text-center\"/><td>_id, _security, _lastUpdated, identifier, active, name, type, partof, hsa-id, hsa-org-class</td><td><code>Organization:partof</code></td><td><code>Organization:partof</code>, <code>Location:organization</code>, <code>HealthcareService:organization</code></td><td/></tr><tr><td><a href=\"#Location1-2\">Location</a></td><td><a href=\"StructureDefinition-hsa-catalog-location.html\">https://hsa.inera.se/fhir/StructureDefinition/hsa-catalog-location</a></td><td class=\"text-center\">y</td><td class=\"text-center\">y</td><td class=\"text-center\"/><td class=\"text-center\"/><td>_id, _security, _lastUpdated, identifier, status, organization, near, hsa-id</td><td><code>Location:organization</code></td><td/><td/></tr><tr><td><a href=\"#HealthcareService1-3\">HealthcareService</a></td><td><a href=\"StructureDefinition-hsa-healthcare-service.html\">https://hsa.inera.se/fhir/StructureDefinition/hsa-healthcare-service</a></td><td class=\"text-center\">y</td><td class=\"text-center\">y</td><td class=\"text-center\"/><td class=\"text-center\"/><td>_id, _security, _lastUpdated, active, organization, location, service-category, service-type, hsa-provided-by</td><td><code>HealthcareService:organization</code>, <code>HealthcareService:location</code></td><td/><td/></tr></tbody></table></div><hr/><div class=\"panel panel-default\"><div class=\"panel-heading\"><h4 id=\"Organization1-1\" class=\"panel-title\"><span style=\"float: right;\">Resurskonformans: unspecified </span>Organization</h4></div><div class=\"panel-body\"><div class=\"container\"><div class=\"row\"><div class=\"col-lg-6\"><span class=\"lead\">Bassystemprofil</span><br/><a href=\"StructureDefinition-hsa-catalog-organization.html\">HSA Catalog Organization</a></div><div class=\"col-lg-3\"><span class=\"lead\">Profilkonformans</span><br/><b>SHALL</b></div><div class=\"col-lg-3\"><span class=\"lead\">Referenspolicy</span><br/><code>resolves</code></div></div><p/><div class=\"row\"><div class=\"col-6\"><span class=\"lead\">Profiler som stöds</span><p><a href=\"StructureDefinition-hsa-healthcare-provider-organization.html\">HSA Healthcare Provider Organization</a><br/><a href=\"StructureDefinition-hsa-healthcare-unit-organization.html\">HSA Healthcare Unit Organization</a></p></div><div class=\"col-lg-6\"><span class=\"lead\">Interaktionssammanfattning</span><br/><ul><li>Stöder <code>read</code>, <code>search-type</code>.</li></ul></div></div><p/><div class=\"row\"><div class=\"col-12\"><span class=\"lead\">Dokumentation</span><blockquote><div><p>Organisationer i HSA-katalogen: vårdgivare, vårdenheter och organisatoriska enheter.</p>\n</div></blockquote></div></div><div class=\"row\"><div class=\"col-lg-7\"><span class=\"lead\">Sökparametrar</span><table class=\"table table-condensed table-hover\"><thead><tr><th>Konformans</th><th>Parameter</th><th>Typ</th><th>Dokumentation</th></tr></thead><tbody><tr><td><b>SHALL</b></td><td>_id</td><td><code>token</code></td><td><div><p>Sökning på resurens FHIR-id.</p>\n</div></td></tr><tr><td><b>SHALL</b></td><td>_security</td><td><code>token</code></td><td><div><p>Filtrering på meta.security. Använd <code>urn:oid:1.2.752.29.23.1.11|03</code> för publika resurser.</p>\n</div></td></tr><tr><td><b>SHALL</b></td><td>_lastUpdated</td><td><code>date</code></td><td><div><p>Filtrering på senaste ändringsdatum (för inkrementell synk).</p>\n</div></td></tr><tr><td><b>SHALL</b></td><td>identifier</td><td><code>token</code></td><td><div><p>Sökning på valfri identifierare. Prefix: <code>urn:oid:1.2.752.29.4.19|SE...</code> för HSA-id.</p>\n</div></td></tr><tr><td><b>SHALL</b></td><td>active</td><td><code>token</code></td><td><div><p>Filtrera på aktiv/inaktiv status.</p>\n</div></td></tr><tr><td><b>SHALL</b></td><td>name</td><td><code>string</code></td><td><div><p>Sökning på organisationsnamn (prefix-match).</p>\n</div></td></tr><tr><td><b>SHALL</b></td><td>type</td><td><code>token</code></td><td><div><p>Sökning på organisationstyp.</p>\n</div></td></tr><tr><td><b>SHALL</b></td><td>partof</td><td><code>reference</code></td><td><div><p>Sökning på överordnad organisation. Stödjer <code>_include:iterate</code> för hierarkisökning.</p>\n</div></td></tr><tr><td><b>SHALL</b></td><td><a href=\"SearchParameter-hsa-id.html\">hsa-id</a></td><td><code>token</code></td><td><div><p>Kortform för sökning på HSA-id (system urn:oid:1.2.752.29.4.19).</p>\n</div></td></tr><tr><td><b>SHALL</b></td><td><a href=\"SearchParameter-hsa-org-class.html\">hsa-org-class</a></td><td><code>token</code></td><td><div><p>Sökning på HSA-objektklass (healthcare-provider, healthcare-unit, organizational-unit).</p>\n</div></td></tr></tbody></table></div><div class=\"col-lg-5\"> </div></div></div></div></div><div class=\"panel panel-default\"><div class=\"panel-heading\"><h4 id=\"Location1-2\" class=\"panel-title\"><span style=\"float: right;\">Resurskonformans: unspecified </span>Location</h4></div><div class=\"panel-body\"><div class=\"container\"><div class=\"row\"><div class=\"col-lg-6\"><span class=\"lead\">Bassystemprofil</span><br/><a href=\"StructureDefinition-hsa-catalog-location.html\">HSA Catalog Location</a></div><div class=\"col-lg-3\"><span class=\"lead\">Profilkonformans</span><br/><b>SHALL</b></div><div class=\"col-lg-3\"><span class=\"lead\">Referenspolicy</span><br/></div></div><p/><div class=\"row\"><div class=\"col-lg-6\"><span class=\"lead\">Interaktionssammanfattning</span><br/><ul><li>Stöder <code>read</code>, <code>search-type</code>.</li></ul></div></div><p/><div class=\"row\"><div class=\"col-12\"><span class=\"lead\">Dokumentation</span><blockquote><div><p>Fysiska besöksplatser och mottagningslokaler i HSA-katalogen.</p>\n</div></blockquote></div></div><div class=\"row\"><div class=\"col-lg-7\"><span class=\"lead\">Sökparametrar</span><table class=\"table table-condensed table-hover\"><thead><tr><th>Konformans</th><th>Parameter</th><th>Typ</th><th>Dokumentation</th></tr></thead><tbody><tr><td><b>SHALL</b></td><td>_id</td><td><code>token</code></td><td><div/></td></tr><tr><td><b>SHALL</b></td><td>_security</td><td><code>token</code></td><td><div><p>Filtrering på destinationIndicator (meta.security).</p>\n</div></td></tr><tr><td><b>SHALL</b></td><td>_lastUpdated</td><td><code>date</code></td><td><div/></td></tr><tr><td><b>SHALL</b></td><td>identifier</td><td><code>token</code></td><td><div/></td></tr><tr><td><b>SHALL</b></td><td>status</td><td><code>token</code></td><td><div/></td></tr><tr><td><b>SHALL</b></td><td>organization</td><td><code>reference</code></td><td><div><p>Filtrering på ansvarig organisation (managingOrganization).</p>\n</div></td></tr><tr><td><b>SHALL</b></td><td>near</td><td><code>special</code></td><td><div><p>Geo-sökning (position.latitude/longitude). Förutsätter koordinatstöd på servern.</p>\n</div></td></tr><tr><td><b>SHALL</b></td><td><a href=\"SearchParameter-hsa-id.html\">hsa-id</a></td><td><code>token</code></td><td><div/></td></tr></tbody></table></div><div class=\"col-lg-5\"> </div></div></div></div></div><div class=\"panel panel-default\"><div class=\"panel-heading\"><h4 id=\"HealthcareService1-3\" class=\"panel-title\"><span style=\"float: right;\">Resurskonformans: unspecified </span>HealthcareService</h4></div><div class=\"panel-body\"><div class=\"container\"><div class=\"row\"><div class=\"col-lg-6\"><span class=\"lead\">Bassystemprofil</span><br/><a href=\"StructureDefinition-hsa-healthcare-service.html\">HSA Healthcare Service</a></div><div class=\"col-lg-3\"><span class=\"lead\">Profilkonformans</span><br/><b>SHALL</b></div><div class=\"col-lg-3\"><span class=\"lead\">Referenspolicy</span><br/></div></div><p/><div class=\"row\"><div class=\"col-lg-6\"><span class=\"lead\">Interaktionssammanfattning</span><br/><ul><li>Stöder <code>read</code>, <code>search-type</code>.</li></ul></div></div><p/><div class=\"row\"><div class=\"col-12\"><span class=\"lead\">Dokumentation</span><blockquote><div><p>Vårdtjänster och tjänsteutbud kopplade till HSA-enheter.</p>\n</div></blockquote></div></div><div class=\"row\"><div class=\"col-lg-7\"><span class=\"lead\">Sökparametrar</span><table class=\"table table-condensed table-hover\"><thead><tr><th>Konformans</th><th>Parameter</th><th>Typ</th><th>Dokumentation</th></tr></thead><tbody><tr><td><b>SHALL</b></td><td>_id</td><td><code>token</code></td><td><div/></td></tr><tr><td><b>SHALL</b></td><td>_security</td><td><code>token</code></td><td><div><p>Filtrering på destinationIndicator (meta.security).</p>\n</div></td></tr><tr><td><b>SHALL</b></td><td>_lastUpdated</td><td><code>date</code></td><td><div/></td></tr><tr><td><b>SHALL</b></td><td>active</td><td><code>token</code></td><td><div/></td></tr><tr><td><b>SHALL</b></td><td>organization</td><td><code>reference</code></td><td><div><p>Filtrering på tillhandahållande organisation (providedBy).</p>\n</div></td></tr><tr><td><b>SHALL</b></td><td>location</td><td><code>reference</code></td><td><div><p>Filtrering på kopplad plats.</p>\n</div></td></tr><tr><td><b>SHALL</b></td><td>service-category</td><td><code>token</code></td><td><div><p>Sökning på verksamhetskod (system urn:oid:1.2.752.129.2.2.1.3).</p>\n</div></td></tr><tr><td><b>SHALL</b></td><td>service-type</td><td><code>token</code></td><td><div><p>Sökning på vård-/omsorgsform (system urn:oid:1.2.752.129.2.2.1.13).</p>\n</div></td></tr><tr><td><b>SHALL</b></td><td><a href=\"SearchParameter-hsa-provided-by.html\">hsa-provided-by</a></td><td><code>reference</code></td><td><div/></td></tr></tbody></table></div><div class=\"col-lg-5\"> </div></div></div></div></div></div>"^^rdf:XMLLiteral ]
  ] ; # 
  fhir:url [ fhir:v "https://hsa.inera.se/fhir/CapabilityStatement/hsa-catalog-server"^^xsd:anyURI] ; # 
  fhir:version [ fhir:v "0.1.0"] ; # 
  fhir:name [ fhir:v "HsaCatalogServer"] ; # 
  fhir:title [ fhir:v "HSA Central Catalog Server"] ; # 
  fhir:status [ fhir:v "draft"] ; # 
  fhir:experimental [ fhir:v false] ; # 
  fhir:date [ fhir:v "2026-05-21"^^xsd:date] ; # 
  fhir:publisher [ fhir:v "Inera AB / HSA-IG projekt"] ; # 
  fhir:contact ( [
     fhir:name [ fhir:v "Inera AB / HSA-IG projekt" ] ;
     fhir:telecom ( [
       fhir:system [ fhir:v "url" ] ;
       fhir:value [ fhir:v "https://www.inera.se/" ]
     ] )
  ] ) ; # 
  fhir:description [ fhir:v "Exempel på serverförmågor för ett centralt HSA-katalog FHIR R5 API med läsaccess."] ; # 
  fhir:jurisdiction ( [
     fhir:coding ( [
       fhir:system [ fhir:v "urn:iso:std:iso:3166"^^xsd:anyURI ] ;
       fhir:code [ fhir:v "SE" ] ;
       fhir:display [ fhir:v "Sweden" ]
     ] )
  ] ) ; # 
  fhir:kind [ fhir:v "requirements"] ; # 
  fhir:fhirVersion [ fhir:v "5.0.0"] ; # 
  fhir:format ( [ fhir:v "json"] [ fhir:v "xml"] ) ; # 
  fhir:rest ( [
     fhir:mode [ fhir:v "server" ] ;
     fhir:documentation [ fhir:v "Läs- och sök-API för HSA-katalogen.\nPublik synlighet filtreras via _security-parametern (destination indicator 03).\nSkrivoperationer stöds inte på detta gränssnitt." ] ;
     fhir:resource ( [
       fhir:type [ fhir:v "Organization" ] ;
       fhir:profile [
         fhir:v "https://hsa.inera.se/fhir/StructureDefinition/hsa-catalog-organization"^^xsd:anyURI ;
         fhir:link <https://hsa.inera.se/fhir/StructureDefinition/hsa-catalog-organization>
       ] ;
       fhir:supportedProfile ( [
         fhir:v "https://hsa.inera.se/fhir/StructureDefinition/hsa-healthcare-provider-organization"^^xsd:anyURI ;
         fhir:link <https://hsa.inera.se/fhir/StructureDefinition/hsa-healthcare-provider-organization>
       ] [
         fhir:v "https://hsa.inera.se/fhir/StructureDefinition/hsa-healthcare-unit-organization"^^xsd:anyURI ;
         fhir:link <https://hsa.inera.se/fhir/StructureDefinition/hsa-healthcare-unit-organization>
       ] ) ;
       fhir:documentation [ fhir:v "Organisationer i HSA-katalogen: vårdgivare, vårdenheter och organisatoriska enheter." ] ;
       fhir:interaction ( [
         fhir:code [ fhir:v "read" ]
       ] [
         fhir:code [ fhir:v "search-type" ]
       ] ) ;
       fhir:versioning [ fhir:v "no-version" ] ;
       fhir:readHistory [ fhir:v false ] ;
       fhir:updateCreate [ fhir:v false ] ;
       fhir:conditionalCreate [ fhir:v false ] ;
       fhir:conditionalUpdate [ fhir:v false ] ;
       fhir:conditionalDelete [ fhir:v "not-supported" ] ;
       fhir:referencePolicy ( [ fhir:v "resolves" ] ) ;
       fhir:searchInclude ( [ fhir:v "Organization:partof" ] ) ;
       fhir:searchRevInclude ( [ fhir:v "Organization:partof" ] [ fhir:v "Location:organization" ] [ fhir:v "HealthcareService:organization" ] ) ;
       fhir:searchParam ( [
         fhir:name [ fhir:v "_id" ] ;
         fhir:type [ fhir:v "token" ] ;
         fhir:documentation [ fhir:v "Sökning på resurens FHIR-id." ]
       ] [
         fhir:name [ fhir:v "_security" ] ;
         fhir:type [ fhir:v "token" ] ;
         fhir:documentation [ fhir:v "Filtrering på meta.security. Använd `urn:oid:1.2.752.29.23.1.11|03` för publika resurser." ]
       ] [
         fhir:name [ fhir:v "_lastUpdated" ] ;
         fhir:type [ fhir:v "date" ] ;
         fhir:documentation [ fhir:v "Filtrering på senaste ändringsdatum (för inkrementell synk)." ]
       ] [
         fhir:name [ fhir:v "identifier" ] ;
         fhir:type [ fhir:v "token" ] ;
         fhir:documentation [ fhir:v "Sökning på valfri identifierare. Prefix: `urn:oid:1.2.752.29.4.19|SE...` för HSA-id." ]
       ] [
         fhir:name [ fhir:v "active" ] ;
         fhir:type [ fhir:v "token" ] ;
         fhir:documentation [ fhir:v "Filtrera på aktiv/inaktiv status." ]
       ] [
         fhir:name [ fhir:v "name" ] ;
         fhir:type [ fhir:v "string" ] ;
         fhir:documentation [ fhir:v "Sökning på organisationsnamn (prefix-match)." ]
       ] [
         fhir:name [ fhir:v "type" ] ;
         fhir:type [ fhir:v "token" ] ;
         fhir:documentation [ fhir:v "Sökning på organisationstyp." ]
       ] [
         fhir:name [ fhir:v "partof" ] ;
         fhir:type [ fhir:v "reference" ] ;
         fhir:documentation [ fhir:v "Sökning på överordnad organisation. Stödjer `_include:iterate` för hierarkisökning." ]
       ] [
         fhir:name [ fhir:v "hsa-id" ] ;
         fhir:definition [
           fhir:v "https://hsa.inera.se/fhir/SearchParameter/hsa-id"^^xsd:anyURI ;
           fhir:link <https://hsa.inera.se/fhir/SearchParameter/hsa-id>
         ] ;
         fhir:type [ fhir:v "token" ] ;
         fhir:documentation [ fhir:v "Kortform för sökning på HSA-id (system urn:oid:1.2.752.29.4.19)." ]
       ] [
         fhir:name [ fhir:v "hsa-org-class" ] ;
         fhir:definition [
           fhir:v "https://hsa.inera.se/fhir/SearchParameter/hsa-org-class"^^xsd:anyURI ;
           fhir:link <https://hsa.inera.se/fhir/SearchParameter/hsa-org-class>
         ] ;
         fhir:type [ fhir:v "token" ] ;
         fhir:documentation [ fhir:v "Sökning på HSA-objektklass (healthcare-provider, healthcare-unit, organizational-unit)." ]
       ] )
     ] [
       fhir:type [ fhir:v "Location" ] ;
       fhir:profile [
         fhir:v "https://hsa.inera.se/fhir/StructureDefinition/hsa-catalog-location"^^xsd:anyURI ;
         fhir:link <https://hsa.inera.se/fhir/StructureDefinition/hsa-catalog-location>
       ] ;
       fhir:documentation [ fhir:v "Fysiska besöksplatser och mottagningslokaler i HSA-katalogen." ] ;
       fhir:interaction ( [
         fhir:code [ fhir:v "read" ]
       ] [
         fhir:code [ fhir:v "search-type" ]
       ] ) ;
       fhir:versioning [ fhir:v "no-version" ] ;
       fhir:readHistory [ fhir:v false ] ;
       fhir:updateCreate [ fhir:v false ] ;
       fhir:conditionalCreate [ fhir:v false ] ;
       fhir:conditionalUpdate [ fhir:v false ] ;
       fhir:conditionalDelete [ fhir:v "not-supported" ] ;
       fhir:searchInclude ( [ fhir:v "Location:organization" ] ) ;
       fhir:searchParam ( [
         fhir:name [ fhir:v "_id" ] ;
         fhir:type [ fhir:v "token" ]
       ] [
         fhir:name [ fhir:v "_security" ] ;
         fhir:type [ fhir:v "token" ] ;
         fhir:documentation [ fhir:v "Filtrering på destinationIndicator (meta.security)." ]
       ] [
         fhir:name [ fhir:v "_lastUpdated" ] ;
         fhir:type [ fhir:v "date" ]
       ] [
         fhir:name [ fhir:v "identifier" ] ;
         fhir:type [ fhir:v "token" ]
       ] [
         fhir:name [ fhir:v "status" ] ;
         fhir:type [ fhir:v "token" ]
       ] [
         fhir:name [ fhir:v "organization" ] ;
         fhir:type [ fhir:v "reference" ] ;
         fhir:documentation [ fhir:v "Filtrering på ansvarig organisation (managingOrganization)." ]
       ] [
         fhir:name [ fhir:v "near" ] ;
         fhir:type [ fhir:v "special" ] ;
         fhir:documentation [ fhir:v "Geo-sökning (position.latitude/longitude). Förutsätter koordinatstöd på servern." ]
       ] [
         fhir:name [ fhir:v "hsa-id" ] ;
         fhir:definition [
           fhir:v "https://hsa.inera.se/fhir/SearchParameter/hsa-id"^^xsd:anyURI ;
           fhir:link <https://hsa.inera.se/fhir/SearchParameter/hsa-id>
         ] ;
         fhir:type [ fhir:v "token" ]
       ] )
     ] [
       fhir:type [ fhir:v "HealthcareService" ] ;
       fhir:profile [
