0</td></tr><tr><td style=\"background-color: #f3f5da\" title=\"Ways to contact the organization\">Kontaktuppgift</td><td colspan=\"3\"><ul><li><a href=\"tel:+46457556688\">+46457556688</a></li><li><a href=\"tel:+46457556600\">+46457556600</a></li><li><a href=\"tel:+46729876543\">+46729876543</a></li><li><a href=\"mailto:ronneby@blekingeprimaervard.se\">ronneby@blekingeprimaervard.se</a></li><li><a href=\"mailto:redaktion.ronneby@blekingeprimaervard.se\">redaktion.ronneby@blekingeprimaervard.se</a></li><li><a href=\"https://www.1177.se/Hitta-vard/Kontakt/?hsaid=SE5566778899-RNBY1\">https://www.1177.se/Hitta-vard/Kontakt/?hsaid=SE5566778899-RNBY1</a></li></ul></td></tr><tr><td style=\"background-color: #f3f5da\" title=\"Ways to contact the organization\">Kontaktuppgift</td><td colspan=\"3\"><ul><li>Järnvägsgatan 14</li></ul></td></tr><tr><td style=\"background-color: #f3f5da\" title=\"Den eller de regioner/kommuner som finansierar vården vid enheten.#xA;Mappar till LDAP-attributet financingOrganization (OID 1.2.752.129.5.1.1).#xA;Koden är den finansierande organisationens organisationsnummer, t.ex.#xA;232100-0081 (Informationsspecifikation HSA 11.3.13), inte ett HSA-id.\"><a href=\"StructureDefinition-hsa-financing-organization.html\">HSA Finansierande region/kommun</a></td><td colspan=\"3\">okänd: 232100-0081 (Region Blekinge)</td></tr><tr><td style=\"background-color: #f3f5da\" title=\"Informationstext riktad till patient som visas på enhetens 1177-sida.#xA;Mappar till LDAP-attributet hsaVpwInformation4.#xA;Klienter bör rendera som Markdown.\"><a href=\"StructureDefinition-hsa-patient-info.html\">HSA Information till patient</a></td><td colspan=\"3\">Du kan lista dig hos oss via 1177.se. Vi tar emot både bokade besök och drop-in.</td></tr></table></div>"^^rdf:XMLLiteral ]
