  fhir:rest ( [
     fhir:mode [ fhir:v "client" ] ;
     fhir:documentation [ fhir:v "1177 Hitta vård använder följande frågemönster:\n1. Geo-sökning: GET /Location?near=[lat]|[lon]|[radius]|km&_security=...03\n   med _revinclude=HealthcareService:location&_revinclude=Organization:organization\n2. Namnssökning: GET /Organization?name=[prefix]&hsa-org-class=healthcare-unit&_security=...03\n3. Hämta detaljer: GET /Organization/[id] + separata anrop för Location och HealthcareService\nAlla anrop filtreras på _security=urn:oid:1.2.752.29.23.1.11|03 (publika resurser)." ] ;
     fhir:resource ( [
       fhir:type [ fhir:v "Organization" ] ;
       fhir:profile [
         fhir:v "https://hsa.inera.se/fhir/StructureDefinition/hsa-catalog-organization"^^xsd:anyURI ;
         fhir:link <https://hsa.inera.se/fhir/StructureDefinition/hsa-catalog-organization>
       ] ;
       fhir:documentation [ fhir:v "Hämtar och visar vårdgivare/vårdenheter. Relevanta fält: name, type, active, contact.telecom, contact.address, meta.security." ] ;
       fhir:interaction ( [
         fhir:code [ fhir:v "read" ]
       ] [
         fhir:code [ fhir:v "search-type" ]
       ] ) ;
       fhir:searchInclude ( [ fhir:v "Organization:partof" ] ) ;
       fhir:searchRevInclude ( [ fhir:v "Location:organization" ] [ fhir:v "HealthcareService:organization" ] ) ;
       fhir:searchParam ( [
         fhir:name [ fhir:v "_security" ] ;
         fhir:type [ fhir:v "token" ]
       ] [
         fhir:name [ fhir:v "name" ] ;
         fhir:type [ fhir:v "string" ] ;
         fhir:documentation [ fhir:v "Namnssökning för fritextsök i 1177." ]
       ] [
         fhir:name [ fhir:v "active" ] ;
         fhir:type [ fhir:v "token" ]
       ] [
         fhir:name [ fhir:v "hsa-org-class" ] ;
         fhir:definition [
           fhir:v "https://hsa.inera.se/fhir/SearchParameter/hsa-org-class"^^xsd:anyURI ;
           fhir:link <https://hsa.inera.se/fhir/SearchParameter/hsa-org-class>
         ] ;
         fhir:type [ fhir:v "token" ] ;
         fhir:documentation [ fhir:v "Filtrera på healthcare-unit för vårdenhetssökning." ]
       ] [
         fhir:name [ fhir:v "partof" ] ;
         fhir:type [ fhir:v "reference" ]
       ] )
     ] [
       fhir:type [ fhir:v "Location" ] ;
       fhir:profile [
         fhir:v "https://hsa.inera.se/fhir/StructureDefinition/hsa-catalog-location"^^xsd:anyURI ;
         fhir:link <https://hsa.inera.se/fhir/StructureDefinition/hsa-catalog-location>
       ] ;
       fhir:documentation [ fhir:v "Geo-sökning och kartvisning. Använder position (SWEREF99), address (fysisk, utan postnummer), description (vägbeskrivning)." ] ;
       fhir:interaction ( [
         fhir:code [ fhir:v "read" ]
       ] [
         fhir:code [ fhir:v "search-type" ]
       ] ) ;
       fhir:searchInclude ( [ fhir:v "Location:organization" ] ) ;
       fhir:searchParam ( [
         fhir:name [ fhir:v "_security" ] ;
         fhir:type [ fhir:v "token" ]
       ] [
         fhir:name [ fhir:v "near" ] ;
         fhir:type [ fhir:v "special" ] ;
         fhir:documentation [ fhir:v "Geo-sökning är primärt frågemönster för kartvisning." ]
       ] [
         fhir:name [ fhir:v "organization" ] ;
         fhir:type [ fhir:v "reference" ]
       ] )
     ] [
       fhir:type [ fhir:v "HealthcareService" ] ;
       fhir:profile [
         fhir:v "https://hsa.inera.se/fhir/StructureDefinition/hsa-healthcare-service"^^xsd:anyURI ;
         fhir:link <https://hsa.inera.se/fhir/StructureDefinition/hsa-healthcare-service>
       ] ;
       fhir:documentation [ fhir:v "Öppettider, verksamhetskod och VPW-texter (Om oss, information till patient, tillfällig info). Använder availability, category[verksamhetskod], comment, extension[temporaryNotice], extension[patientInfo]." ] ;
       fhir:interaction ( [
