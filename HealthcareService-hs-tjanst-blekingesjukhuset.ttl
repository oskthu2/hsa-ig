     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Genererad berättande text: HealthcareService hs-tjanst-blekingesjukhuset</b></p><a name=\"hs-tjanst-blekingesjukhuset\"> </a><a name=\"hchs-tjanst-blekingesjukhuset\"> </a><div style=\"display: inline-block; background-color: #fbffeb; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\"><p style=\"margin-bottom: 0px\"/><p style=\"margin-bottom: 0px\">Profil: <a href=\"StructureDefinition-hsa-healthcare-service.html\">HSA Healthcare Service</a></p><p style=\"margin-bottom: 0px\">Säkerhetsetikett: </p></div><p style=\"border: 1px #661aff solid; background-color: #e6e6ff; padding: 10px;\">Internmedicin och Kardiologi (Öppen vård) by Blekingesjukhuset (Vårdenhet, Specialiserad somatisk vård, Sjukhus, Landsting/region) (urn:oid:1.2.752.29.4.19#HSA-identitet (HSA-id)#SE2321000081-BSJH01)</p><hr/><table class=\"grid\"><tr><td style=\"background-color: #f3f5da\" title=\"Posten är aktiv\">Aktiv:</td><td colspan=\"3\">true</td></tr><tr><td style=\"background-color: #f3f5da\" title=\"The organization that provides this service\">Provided By:</td><td colspan=\"3\"><a href=\"Organization-blekingesjukhuset-vardenhet.html\">Blekingesjukhuset (Vårdenhet, Specialiserad somatisk vård, Sjukhus, Landsting/region) (urn:oid:1.2.752.29.4.19#HSA-identitet (HSA-id)#SE2321000081-BSJH01)</a></td></tr><tr><td style=\"background-color: #f3f5da\" title=\"Broad category of service being performed or delivered\">Category:</td><td colspan=\"3\"><span title=\"Koder:{urn:oid:1.2.752.129.2.2.1.3 1101}, {urn:oid:1.2.752.129.2.2.1.3 1126}\">Internmedicin</span></td></tr><tr><td style=\"background-color: #f3f5da\" title=\"The type of service that may be delivered or performed\">Type:</td><td colspan=\"3\"><span title=\"Koder:{urn:oid:1.2.752.129.2.2.1.13 01}, {urn:oid:1.2.752.129.2.2.1.13 02}\">Öppen vård</span></td></tr><tr><td style=\"background-color: #f3f5da\" titl