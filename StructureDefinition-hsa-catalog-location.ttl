     ] [
       fhir:id [ fhir:v "Location.position.altitude" ] ;
       fhir:path [ fhir:v "Location.position.altitude" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Location.managingOrganization" ] ;
       fhir:path [ fhir:v "Location.managingOrganization" ] ;
