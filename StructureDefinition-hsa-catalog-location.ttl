       fhir:short [ fhir:v "instance = fysisk plats" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Location.address" ] ;
       fhir:path [ fhir:v "Location.address" ] ;
       fhir:short [ fhir:v "Besöksadress (fysisk)" ] ;
       fhir:definition [ fhir:v "Enhetens besöksadress (typ=physical). Ska aldrig innehålla postnummer\n(Uppsala-regel; postnummer hör till postadress på Organization)." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Location.address.type" ] ;
       fhir:path [ fhir:v "Location.address.type" ] ;
       fhir:fixed [
         a fhir:code ;
         fhir:v "physical"
       ]
     ] [
