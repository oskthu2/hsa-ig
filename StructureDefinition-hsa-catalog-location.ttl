       fhir:definition [ fhir:v "Fritext-beskrivning med yttre och inre vägbeskrivning. Klienter bör rendera\nsom Markdown. Rekommenderade rubriker: `## Yttre vägbeskrivning` och\n`## Inre vägbeskrivning`." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
