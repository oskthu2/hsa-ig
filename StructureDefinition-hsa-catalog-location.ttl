  fhir:differential [
     fhir:element ( [
       fhir:id [ fhir:v "Location" ] ;
       fhir:path [ fhir:v "Location" ] ;
       fhir:constraint ( [
         fhir:key [ fhir:v "hsacat-physical-location-address" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "En fysisk plats (mode = instance) SHALL ha besöksadress." ] ;
         fhir:expression [ fhir:v "mode = 'instance' implies address.where(type = 'physical' or type = 'both').exists()" ] ;
         fhir:source [
           fhir:v "https://hsa.inera.se/fhir/StructureDefinition/hsa-catalog-location"^^xsd:anyURI ;
           fhir:link <https://hsa.inera.se/fhir/StructureDefinition/hsa-catalog-location>
         ]
       ] [
         fhir:key [ fhir:v "hsacat-physical-location-city" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "En fysisk plats SHALL ha lokalitet (address.city)." ] ;
         fhir:expression [ fhir:v "mode = 'instance' implies address.where(type = 'physical' or type = 'both').city.exists()" ] ;
         fhir:source [
           fhir:v "https://hsa.inera.se/fhir/StructureDefinition/hsa-catalog-location"^^xsd:anyURI ;
           fhir:link <https://hsa.inera.se/fhir/StructureDefinition/hsa-catalog-location>
         ]
       ] [
         fhir:key [ fhir:v "hsacat-public-location-position" ] ;
         fhir:severity [ fhir:v "warning" ] ;
         fhir:human [ fhir:v "En fysisk plats som är publik (destination indicator 03) SHOULD ha geografiska koordinater." ] ;
         fhir:expression [ fhir:v "meta.security.where(system = 'urn:oid:1.2.752.29.23.1.11' and code = '03').exists() implies position.exists()" ] ;
         fhir:source [
           fhir:v "https://hsa.inera.se/fhir/StructureDefinition/hsa-catalog-location"^^xsd:anyURI ;
           fhir:link <https://hsa.inera.se/fhir/StructureDefinition/hsa-catalog-location>
         ]
       ] )
     ] [
       fhir:id [ fhir:v "Location.meta.security" ] ;
       fhir:path [ fhir:v "Location.meta.security" ] ;
       fhir:slicing [
         fhir:discriminator ( [
           fhir:type [ fhir:v "value" ] ;
           fhir:path [ fhir:v "system" ]
         ] ) ;
         fhir:rules [ fhir:v "open" ]
       ] ;
       fhir:short [ fhir:v "Åtkomstkontroll och publiceringsscope" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Location.meta.security:destination-indicator" ] ;
       fhir:path [ fhir:v "Location.meta.security" ] ;
       fhir:sliceName [ fhir:v "destination-indicator" ] ;
       fhir:short [ fhir:v "Publik synlighet (hsaDestinationIndicator, OID 1.2.752.29.23.1.11)" ] ;
       fhir:definition [ fhir:v "Kod 03 = Internet/allmänheten. Anger att platsen är synlig på t.ex. 1177 Hitta vård." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Location.meta.security:destination-indicator.system" ] ;
       fhir:path [ fhir:v "Location.meta.security.system" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:fixed [
         a fhir:uri ;
         fhir:v "urn:oid:1.2.752.29.23.1.11"^^xsd:anyURI
       ]
     ] [
       fhir:id [ fhir:v "Location.meta.security:destination-indicator.code" ] ;
       fhir:path [ fhir:v "Location.meta.security.code" ] ;
       fhir:binding [
